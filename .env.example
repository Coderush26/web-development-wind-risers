# ── Copy this file to .env and fill in all values ──────────────────────────
# docker compose up  reads .env automatically from the project root.
# npm run dev        in /server also reads this if you symlink: ln -s ../.env .env
#                    OR keep a separate server/.env for local dev.
# ────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas URI (used for local dev; overridden by docker-compose for Docker)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.example.mongodb.net/CodeRush

# JWT — any long random string
JWT_SECRET=change_me_to_a_long_random_secret

# Pusher — https://dashboard.pusher.com  (Channels app)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Same key/cluster exposed to the React client (Vite bakes these in at build time)
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=

# Groq AI — https://console.groq.com
GROQ_API_KEY=

# Open-Meteo (no key needed — just set the base URL)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Nodemailer — Gmail App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Allowed CORS origin (overridden to http://localhost:3000 in docker-compose)
CLIENT_URL=http://localhost:3000
